{
  "name": "geokinematics-3d",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "description": "Deterministic computational platform for rock-slope kinematic analysis, combining geological geometry, stereonet projection, 3D visualization, and Rust/WASM algorithms.",
  "homepage": "https://github.com/nabielnovelkhubran/GeoKinematics-3D#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nabielnovelkhubran/GeoKinematics-3D.git"
  },
  "keywords": [
    "geotechnical-engineering",
    "rock-mechanics",
    "kinematic-analysis",
    "stereonet",
    "wulff-net",
    "structural-geology",
    "wasm",
    "rust",
    "threejs",
    "slope-stability"
  ],
  "author": "nabiel khubran",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm wasm:build && pnpm --filter @geokinematics/web dev",
    "build": "pnpm wasm:build && pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm wasm:build && pnpm --filter @geokinematics/web test:e2e",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "wasm:build": "wasm-pack build crates/geokinematics-core --target web --out-dir ../../apps/web/src/lib/wasm/generated --out-name geokinematics_core",
    "rust:test": "cargo test --workspace",
    "rust:format:check": "cargo fmt --check",
    "rust:lint": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "verify": "pnpm format:check && pnpm wasm:build && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e && pnpm rust:test && pnpm rust:format:check && pnpm rust:lint"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
