{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@geokinematics/wasm-core": ["src/lib/wasm/generated/geokinematics_core"],
      "@geokinematics/domain": ["../../packages/domain/src/index.ts"],
      "@geokinematics/geometry": ["../../packages/geometry/src/index.ts"],
      "@geokinematics/kinematics": ["../../packages/kinematics/src/index.ts"],
      "@geokinematics/ui": ["../../packages/ui/src/index.ts"]
    },
    "allowJs": true,
    "isolatedModules": true
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
